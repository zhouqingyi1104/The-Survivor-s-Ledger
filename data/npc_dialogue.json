{
  "schema": 1,
  "actors": {
    "ning": {
      "openers": {
        "n_o1": {"text": "缸里结了冰。要紧的话先说。", "tone": "all"},
        "n_o2": {"text": "药在火上滚。抽身不开。", "tone": "all"},
        "n_o3": {"text": "阿爹喝下药，今早能坐起来了。多亏你那包。", "tone": "all"},
        "n_o4": {"text": "半个时辰后要去挑水。", "tone": "all"},
        "n_o5": {"text": "这包艾草，上回剩的。你收着。", "tone": "all"},
        "n_o6": {"text": "粥在灶上温着。站不久。", "tone": "all"},
        "n_o7": {"text": "上回替我取药，记着。", "tone": "warm"},
        "n_o8": {"text": "上回借的晾衣绳，今早还了。还你的。", "tone": "warm"},
        "n_o9": {"text": "药钱照市价。不赊。", "tone": "guarded"},
        "n_o10": {"text": "柜里只取一包。莫多动。", "tone": "guarded"}
      },
      "closers": {
        "n_c1": {"text": "话说到这儿。这个价，成不成。", "tone": "all"},
        "n_c2": {"text": "有事敲两下墙。", "tone": "all"},
        "n_c3": {"text": "搁着也使得。米先留我处，不催你。", "tone": "all"},
        "n_c4": {"text": "明早井台见。桶我带。", "tone": "all"},
        "n_c5": {"text": "撂句话。我好赶回去烧火。", "tone": "all"},
        "n_c6": {"text": "得回去了。再晚不敢走夜路。", "tone": "all"},
        "n_c7": {"text": "粥搁你门口了。碗还我。", "tone": "warm"},
        "n_c8": {"text": "我这也紧。半升米，还分得开。", "tone": "warm"},
        "n_c9": {"text": "应下就照这个办。艾草照送。", "tone": "guarded"},
        "n_c10": {"text": "价说定，才好备药。", "tone": "guarded"}
      }
    },
    "zhou": {
      "openers": {
        "z_o1": {"text": "料场那半边棚，让雪压塌了。你订的料在里头。", "tone": "all"},
        "z_o2": {"text": "铁钉数过两遍，只剩半包。你那份活，紧着点。", "tone": "all"},
        "z_o3": {"text": "肩上还挂着刨花，刚从料场来。", "tone": "all"},
        "z_o4": {"text": "锯刚磨好，刃口还烫。你家的活，今日能动。", "tone": "all"},
        "z_o5": {"text": "天黑前得卸完这车料。", "tone": "all"},
        "z_o6": {"text": "未时赶车走。这早晚还空着。", "tone": "all"},
        "z_o7": {"text": "上回那碗热汤，还记着。", "tone": "warm"},
        "z_o8": {"text": "上回抬梁，你搭了把手。", "tone": "warm"},
        "z_o9": {"text": "料先付后取。莫怪我。", "tone": "guarded"},
        "z_o10": {"text": "做归我做。搬料不揽。", "tone": "guarded"}
      },
      "closers": {
        "z_c1": {"text": "成不成，回我一句。好动手。", "tone": "all"},
        "z_c2": {"text": "回去接着刨那根料。", "tone": "all"},
        "z_c3": {"text": "明早这时推车过来。", "tone": "all"},
        "z_c4": {"text": "不行早说。料莫糟践。", "tone": "all"},
        "z_c5": {"text": "你要的料，搁后院了。", "tone": "all"},
        "z_c6": {"text": "得回去扫锯末。", "tone": "all"},
        "z_c7": {"text": "这堆料先给你码上。", "tone": "warm"},
        "z_c8": {"text": "料价涨了。我自家也紧。", "tone": "warm"},
        "z_c9": {"text": "照这个价。三天不涨。", "tone": "guarded"},
        "z_c10": {"text": "不成也言语一声。莫晾着我。", "tone": "guarded"}
      }
    },
    "traveler": {
      "openers": {
        "t_o1": {"text": "今早的街面空得反常。你出门，也当心。", "tone": "all"},
        "t_o2": {"text": "城门口的尸群挪了，往东去。你这边还安稳。", "tone": "all"},
        "t_o3": {"text": "这双鞋，走烂三回了。你门口这段路，更费鞋。", "tone": "all"},
        "t_o4": {"text": "包袱里就剩半张饼。这趟得做成了。", "tone": "all"},
        "t_o5": {"text": "天黑前要出西门。", "tone": "all"},
        "t_o6": {"text": "趁雪没化，檐下多站一时。", "tone": "all"},
        "t_o7": {"text": "肯留我喝碗热的，少见。", "tone": "warm"},
        "t_o8": {"text": "上回临走，塞我半张饼。", "tone": "warm"},
        "t_o9": {"text": "不留宿。饭也不吃。", "tone": "guarded"},
        "t_o10": {"text": "借你檐下站站，不进屋。", "tone": "guarded"}
      },
      "closers": {
        "t_c1": {"text": "今夜睡城西的破庙。", "tone": "all"},
        "t_c2": {"text": "下回打这儿过，敲你的门。", "tone": "all"},
        "t_c3": {"text": "撂句话。我好趁天亮走。", "tone": "all"},
        "t_c4": {"text": "不肯就摇头。不纠缠。", "tone": "all"},
        "t_c5": {"text": "这包盐，搁你门板上。", "tone": "all"},
        "t_c6": {"text": "这就上路。天亮前出巷。", "tone": "all"},
        "t_c7": {"text": "热汤你留着。我喝过了。", "tone": "warm"},
        "t_c8": {"text": "下回捎双厚袜。", "tone": "warm"},
        "t_c9": {"text": "应不下就摇头。我另找人。", "tone": "guarded"},
        "t_c10": {"text": "话摆明了。不赊，也不欠米。", "tone": "guarded"}
      }
    }
  }
